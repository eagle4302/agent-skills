# Claude desktop app's skill-sync cache: machine-written, carries account IDs, and this repo is public.
synced/

# REA rewrites its own skill docs when it updates: a *.rea.backup lands next to every rewritten
# file, and a *.rea.backup.<sha>.recovery copy holds the pre-rewrite version.
*.rea.backup
*.rea.backup.*.recovery

# Bytecode from the Python helpers that ship with some skills.
__pycache__/
*.pyc

# graphify installer backup when the installed skill differs from the packaged one.
SKILL.md.bak

# svg-first-ui example renders: every PNG is regenerated from the sibling SVG (or re-captured
# from the running app), so the repository keeps the SVG source, not the render.
svg-first-ui/examples/**/*.png
